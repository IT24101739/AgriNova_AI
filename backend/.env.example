# AgriShield / CropGuard AI - Backend Environment Configuration
# Copy this file to backend/.env and fill in your values

# ── Supabase Credentials ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Database (Supabase PostgreSQL direct connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage
STORAGE_BUCKET=crop-images

# ── Feature Slice 1 (Member 1: Image Classifier) ────────────
# Path to your .pth model file (EfficientNet-B0 / MobileNetV3 trained on PlantVillage)
# Leave empty or set DEV_MODE=true to return simulated predictions
MODEL_PATH=./models/plant_disease_efficientnet.pth
DEV_MODE=false
MEMBER1_API_BASE=http://localhost:8000

# ── Feature Slice 2 (Member 2: Smart Diagnosis & Advisory) ───
# LLM Provider for multilingual treatment advice (gemini or openai)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key

# Open-Meteo Weather API (free, no API key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Regional Outbreak Scan Settings
OUTBREAK_RADIUS_KM=5
OUTBREAK_WINDOW_DAYS=7
OUTBREAK_HIGH_THRESHOLD=3

# ── Server & Frontend Config ───────────────────────────────
FRONTEND_URL=http://localhost:5173
