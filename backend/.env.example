# Environment Variables — Backend
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Database (Supabase PostgreSQL direct connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# AI Model
# Path to your .pth model file (EfficientNet-B0 / MobileNetV3 trained on PlantVillage)
# Leave empty to run in DEV_MODE (returns placeholder predictions)
MODEL_PATH=./models/plant_disease_efficientnet.pth

# Dev mode: set to "true" to use placeholder AI predictions (no real model needed)
DEV_MODE=false

# Supabase Storage
STORAGE_BUCKET=crop-images

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
